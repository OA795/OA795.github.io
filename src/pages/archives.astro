---
import { ArrowUpRight, CalendarDays } from "@lucide/astro";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfileSidebar from "../components/ProfileSidebar.astro";
import { postSlug } from "../lib/post-path";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const years = [...new Set(posts.map((post) => post.data.date.getFullYear()))];
---

<BaseLayout title="文章归档" description="按时间浏览个人博客的全部文章。">
  <div class="shell page-frame">
    <ProfileSidebar current="文章" />
    <section class="content-panel">
      <header class="panel-heading page-heading">
        <div>
          <p class="section-kicker">THE ARCHIVE</p>
          <h1>文章归档</h1>
          <p>把零散的思考放回时间里，它们会慢慢显出自己的方向。</p>
        </div>
      </header>
      <div class="archive-list">
        {years.map((year) => (
          <section class="archive-year">
            <h2>{year}</h2>
            <div class="archive-items">
              {posts.filter((post) => post.data.date.getFullYear() === year).map((post) => (
                <a class="archive-item" href={"/posts/" + postSlug(post.id) + "/"}>
                  <span class="archive-date"><CalendarDays size={15} /> {post.data.date.toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" })}</span>
                  <span class="archive-title">{post.data.title}</span>
                  <span class="archive-category">{post.data.category}</span>
                  <ArrowUpRight size={17} />
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
